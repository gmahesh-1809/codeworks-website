---
layout: layouts/base.njk
---
<section style="padding:clamp(40px,5vw,72px) clamp(8px,2.5vw,32px) clamp(32px,4vw,48px)">
  <div class="cw-eyebrow">Legal</div>
  <h1 style="margin:16px 0 0;font:800 var(--fs-h1)/1.02 'Bricolage Grotesque';letter-spacing:-0.04em;max-width:16ch;text-wrap:balance">{{ heading }}</h1>
{% if updated %}  <p style="margin:18px 0 0;color:var(--ink-2);font-size:var(--fs-lead)">Last updated {{ updated }}</p>
{% endif %}</section>
<section class="cw-prose" style="background:var(--surface);border:1px solid var(--line);border-radius:var(--r-xl);padding:clamp(24px,4vw,56px)">
{{ content | safe }}
</section>
