{%- set section = "products" if (active == "products" or active in (products | join(",", "key")).split(",")) else active -%}
{%- macro navlink(key, label, url) -%}
<a class="cw-navi{% if section == key %} on{% endif %}"{% if section == key %} aria-current="page"{% endif %} href="{{ url }}">{{ label }}</a>
{%- endmacro -%}
{%- set moon -%}<svg class="i-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>{%- endset -%}
{%- set sun -%}<svg class="i-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>{%- endset -%}
{%- set chev -%}<svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5"></path></svg>{%- endset -%}
{%- set chevLg -%}<svg width="16" height="16" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5"></path></svg>{%- endset -%}
<div class="cw-hdr-host" style="position:sticky;top:12px;z-index:50">
<header style="position:relative;font-family:'DM Sans',sans-serif;padding-bottom:24px">
  <div class="cw-hdr" data-cw-hdr>
    <a class="cw-logo" href="/" aria-label="Codeworks home"><img class="ll" src="/assets/images/codeworks-logo.svg" alt="Codeworks" width="512" height="74" style="height:31px;width:auto;display:block"><img class="ld" src="/assets/images/codeworks-logo-dark.svg" alt="" width="512" height="74" style="height:31px;width:auto"></a>
    <nav aria-label="Primary" class="cw-nav">
      {{ navlink("company", "Company", "/company/") }}
      <div class="cw-dd" data-cw-dd>
        <div class="cw-navi cw-navgrp{% if section == 'products' %} on{% endif %}"><a href="/products/"{% if section == 'products' %} aria-current="page"{% endif %}>Products</a><button type="button" class="cw-chev" aria-label="Products menu" aria-expanded="false" aria-controls="cw-menu-products">{{ chev | safe }}</button></div>
        <div class="cw-menu-wrap" id="cw-menu-products" style="left:-6px" hidden><div class="cw-menu" style="width:min(440px,92vw)">
          {% for p in products -%}
          <a class="cw-mi{% if active == p.key %} on{% endif %}" href="{{ p.url }}"><span class="cw-mth" aria-hidden="true">{% include "partials/thumb-" + p.key + ".svg" %}</span><span class="cw-mt"><b>{{ p.name }}</b><small>{{ p.tagline }}</small></span><span class="arr" aria-hidden="true">→</span></a>
          {%- endfor %}
          <a class="cw-mi cw-mi-all" href="/products/"><span class="cw-mt"><b>All Products</b></span><span class="arr" aria-hidden="true">→</span></a>
        </div></div>
      </div>
      {{ navlink("tech", "Technology", "/technology/") }}
      {{ navlink("services", "Services", "/services/") }}
      <div class="cw-dd" data-cw-dd>
        <div class="cw-navi cw-navgrp{% if section == 'resources' %} on{% endif %}"><a href="/resources/"{% if section == 'resources' %} aria-current="page"{% endif %}>Resources</a><button type="button" class="cw-chev" aria-label="Resources menu" aria-expanded="false" aria-controls="cw-menu-resources">{{ chev | safe }}</button></div>
        <div class="cw-menu-wrap" id="cw-menu-resources" style="right:-6px" hidden><div class="cw-menu" style="width:min(270px,92vw)">
          {% for r in nav.resources -%}
          <a class="cw-mi" href="/resources/#{{ r.key }}"><span class="cw-mt"><b style="font-weight:500">{{ r.name }}</b></span><span class="arr" aria-hidden="true">→</span></a>
          {%- endfor %}
        </div></div>
      </div>
      <a class="cw-btn cw-btn-sm {{ 'cw-btn-ink' if active == 'contact' else 'cw-btn-primary' }}"{% if active == 'contact' %} aria-current="page"{% endif %} href="/contact/" style="margin-left:10px">Contact</a>
      <button type="button" class="cw-theme" data-cw-theme aria-label="Switch to dark theme" title="Switch to dark theme" style="margin-left:6px">{{ moon | safe }}{{ sun | safe }}</button>
    </nav>
    <button type="button" class="cw-theme cw-mob" data-cw-theme aria-label="Switch to dark theme" title="Switch to dark theme" style="margin-left:auto">{{ moon | safe }}{{ sun | safe }}</button>
    <button type="button" class="cw-burger cw-mob" style="margin-left:0" aria-label="Menu" aria-expanded="false" aria-controls="cw-mnav"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg></button>
  </div>
  <nav aria-label="Mobile" id="cw-mnav" class="cw-menu cw-mnav" style="position:absolute;left:0;right:0;top:80px;max-height:calc(100vh - 110px);overflow:auto;border-radius:24px;padding:8px 20px 20px;gap:0" hidden>
    <div class="cw-mrow"><a class="cw-ml" href="/company/" style="color:var(--ink);font-size:16.5px;font-weight:500">Company</a></div>
    <div class="cw-mrow"><a class="cw-ml" href="/products/" style="color:var(--ink);font-size:16.5px;font-weight:500">Products</a><button type="button" class="cw-mtog" aria-expanded="false" aria-controls="cw-msub-products" aria-label="Show Products links">{{ chevLg | safe }}</button></div>
    <div id="cw-msub-products" hidden>
      {% for p in products -%}
      <div class="cw-mrow sub"><a class="cw-ml" href="{{ p.url }}" style="color:var(--ink-2);font-size:15px;font-weight:400">{{ p.name }}</a></div>
      {%- endfor %}
    </div>
    <div class="cw-mrow"><a class="cw-ml" href="/technology/" style="color:var(--ink);font-size:16.5px;font-weight:500">Technology</a></div>
    <div class="cw-mrow"><a class="cw-ml" href="/services/" style="color:var(--ink);font-size:16.5px;font-weight:500">Services</a></div>
    <div class="cw-mrow"><a class="cw-ml" href="/resources/" style="color:var(--ink);font-size:16.5px;font-weight:500">Resources</a><button type="button" class="cw-mtog" aria-expanded="false" aria-controls="cw-msub-resources" aria-label="Show Resources links">{{ chevLg | safe }}</button></div>
    <div id="cw-msub-resources" hidden>
      {% for r in nav.resources -%}
      <div class="cw-mrow sub"><a class="cw-ml" href="/resources/#{{ r.key }}" style="color:var(--ink-2);font-size:15px;font-weight:400">{{ r.name }}</a></div>
      {%- endfor %}
    </div>
    <a class="cw-btn cw-btn-primary cw-btn-lg" href="/contact/" style="position:sticky;bottom:0;margin-top:12px">Contact</a>
  </nav>
</header>
</div>
